{
  "name": "@laioutr/app-battery-included",
  "version": "1.3.0",
  "description": "BatteryIncluded search and recommendations for Laioutr",
  "repository": "laioutr/app-battery-included",
  "license": "MIT",
  "packageManager": "pnpm@10.11.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist",
    "CHANGELOG.md",
    "laioutr.manifest.json"
  ],
  "scripts": {
    "build": "rm -rf dist && nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "dev": "pnpm run dev:prepare && nuxi dev playground",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "prepack": "nuxt-module-build build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run prepack && changeset publish",
    "release:cockpit": "LAIOUTR_API_KEY=\"$LAIOUTR_APP_PUBLISH_KEY\" laioutr app release"
  },
  "dependencies": {
    "@nuxt/kit": "3.16.2",
    "defu": "6.1.4"
  },
  "peerDependencies": {
    "@laioutr-core/canonical-types": ">=0.40.1",
    "@laioutr-core/core-types": ">=0.80.0",
    "@laioutr-core/frontend-core": ">=0.80.0",
    "@laioutr-core/kit": ">=0.80.0",
    "@laioutr-core/orchestr": ">=0.80.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@laioutr-app/shopify": "^0.52.1",
    "@laioutr-core/canonical-types": "^0.40.1",
    "@laioutr-core/core-types": "^0.80.0",
    "@laioutr-core/devtools": "^0.80.0",
    "@laioutr-core/frontend-core": "^0.80.0",
    "@laioutr-core/kit": "^0.80.0",
    "@laioutr-core/orchestr": "^0.80.0",
    "@laioutr/cli": "^0.6.1",
    "@laioutr/eslint-config": "^1.9.5",
    "@laioutr/prettier-config": "^1.1.0",
    "@nuxt/devtools-ui-kit": "2.5.0",
    "@nuxt/module-builder": "^1.0.1",
    "@nuxt/schema": "3.16.2",
    "@nuxt/test-utils": "^3.19.1",
    "@types/node": "22.15.32",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.35.0",
    "nuxt": "3.16.2",
    "prettier": "^3.6.2",
    "typescript": "^5.7.2",
    "unocss": "66.2.3",
    "vitest": "3.1.1",
    "vue-tsc": "^2.1.10"
  }
}
